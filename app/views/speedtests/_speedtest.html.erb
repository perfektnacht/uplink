<%# Lives inside the Internet card, because that is the thing it measures. %>
<div id="speedtest" class="speed">
  <% if speedtest.nil? %>
    <p class="speed__idle">not measured yet</p>
  <% elsif speedtest.error.present? %>
    <p class="speed__error"><%= speedtest.error %></p>
  <% elsif speedtest.down_mbps.nil? %>
    <p class="speed__running">measuring…</p>
  <% else %>
    <dl class="speed__pair">
      <div><dt>↓</dt><dd><%= speedtest.down_mbps %></dd></div>
      <div><dt>↑</dt><dd><%= speedtest.up_mbps %></dd></div>
    </dl>
    <p class="speed__foot">
      <span><%= speedtest.latency_ms %>ms</span>
      <time datetime="<%= speedtest.created_at.iso8601 %>"><%= time_ago_in_words(speedtest.created_at) %> ago</time>
    </p>
  <% end %>
</div>
