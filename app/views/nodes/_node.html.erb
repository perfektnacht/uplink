<%= tag.article id: dom_id(node),
      class: class_names("node", "node--#{node.rollup_status}"),
      style: "--x:#{node.x}px; --y:#{node.y}px; --w:#{node.width}px; --tint:#{node_tint(node.kind)}",
      data: { controller: "node", node_url_value: node_path(node) } do %>

  <header class="node__head" data-action="pointerdown->node#start">
    <h2 class="node__name"><%= node.name %></h2>
    <%= render "nodes/dot", probeable: node %>
  </header>

  <%# The kind is spelled out rather than drawn. An icon here would depend on
      whatever glyphs the current Nerd Font happens to carry, and a router that
      renders as a plug is worse than no icon at all. %>
  <p class="node__meta">
    <%# A node named "Switch" whose kind is switch does not need to say so twice. %>
    <% unless node.name.casecmp?(node.kind) %>
      <span class="node__kind"><%= node.kind %></span>
    <% end %>
    <% if node.address.present? %>
      <span class="node__addr"><%= node.address %></span>
    <% end %>
    <% if node.status_up? && node.latency_ms %>
      <span class="node__latency"><%= node.latency_ms %>ms</span>
    <% elsif node.status_down? %>
      <span class="node__error"><%= node.probes.last&.error %></span>
    <% end %>
  </p>

  <% if node.internet? %>
    <%= render "speedtests/speedtest", speedtest: Speedtest.latest %>
    <button class="node__speedtest" data-controller="speedtest"
            data-action="speedtest#run" data-speedtest-url-value="<%= speedtests_path %>">
      run speedtest
    </button>
  <% end %>

  <% if node.uses.any? %>
    <ul class="uses">
      <% node.uses.each do |link| %>
        <li class="uses__chip">
          <%= link_to edit_link_path(link), class: "uses__link",
                data: { turbo_frame: "inspector" },
                title: link.label.presence ? "#{link.label} via #{link.to_node.name}" : "uses #{link.to_node.name}" do %>
            <%= render "nodes/dot", probeable: link.to_node %>
            <span><%= link.caption %></span>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>

  <% if node.services.any? %>
    <ul class="services">
      <%= render node.services %>
    </ul>
  <% end %>

  <div class="node__tools">
    <%= link_to "edit", edit_node_path(node), class: "node__tool",
          data: { turbo_frame: "inspector" } %>
    <button class="node__tool node__tool--wire" data-action="pointerdown->node#wire"
            title="Drag onto another node to draw a cable">wire</button>
  </div>
<% end %>
