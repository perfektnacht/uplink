<%# Shared by both views. The canvas is where you edit, so its tools do not
    follow you into the grove: the grove is something you look at, and a button
    that changes something does not belong there. The reading itself still
    shows up — the orb is sized by the last speedtest — but taking one is an
    action, and actions live on the canvas. %>
<% canvas = local_assigns.fetch(:canvas, true) %>

<div class="hud">
  <div class="hud__left">
    <span class="hud__mark">uplink</span>
    <%= render "uplink/theme_name" %>
  </div>

  <nav class="hud__views">
    <%= link_to "canvas", root_path,  class: class_names("hud__view", "hud__view--on" => canvas) %>
    <%# The route, the class and the model are still "grove"; the word on the tab
        is the tree's own name. %>
    <%= link_to "Yggdrasil", grove_path, class: class_names("hud__view", "hud__view--on" => !canvas) %>
  </nav>

  <div class="hud__right">
    <% if canvas %>
      <%= link_to "add node", new_node_path, class: "btn",
            data: { turbo_frame: "inspector", canvas_target: "addNode" } %>

      <button class="btn" data-controller="speedtest" data-action="speedtest#run"
              data-speedtest-url-value="<%= speedtests_path %>"
              title="Measure the line. Moves about 30MB.">speedtest</button>

      <button class="btn" data-canvas-target="privacyButton" data-action="canvas#togglePrivacy"
              title="Redact addresses for screenshots (p)">privacy</button>
      <button class="btn" data-action="canvas#reset" title="Fit everything on screen (f)">fit</button>
      <button class="btn" data-canvas-target="modeButton" data-action="canvas#toggleMode"
              title="Toggle edit mode (e)">view</button>
    <% end %>
  </div>
</div>
