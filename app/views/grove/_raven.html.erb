<%# A raven is a node that is not on this network — a VPS in a datacentre, a
    box at someone else's house. It has no cable, so it cannot be a branch; it
    is a visitor. One that answers comes down onto a twig with its wings still
    spread. One that does not is on the ground a long way from the tree,
    working for a living. %>
<g class="raven raven--<%= raven[:pose] %>"
   transform="translate(<%= raven[:x] %> <%= raven[:y] %>) scale(<%= raven[:flip] ? -raven[:scale] : raven[:scale] %> <%= raven[:scale] %>)">
  <% if raven[:pose] == "flying" %>
    <%# A bird the tree had no twig left for. Drawn from further off than the
        other two and so drawn with less: at this size the primaries, the eye
        and the legs are each smaller than a stroke, and a shape that keeps
        them turns to mush rather than to detail.

        Three things survive the distance, and they are the three that say
        which bird this is. The head pushed out in front, because a gull has
        barely any. The broad arm of the wing, rather than the swept scythe a
        gull flies on. And the wedge behind — a raven's tail is diamond-ended
        where a crow's is square, which is the one field mark that tells those
        two apart at range, and the only reason this is a raven and not a
        silhouette of the idea of a bird.

        Both wings caught on the downstroke. Level wings would draw the letter
        M, which is every piece of clip-art gull ever committed. %>
    <path class="raven__body" d="M-26-5C-19-10-10-11-4-7C-3-10-1-12 0-12C1-12 3-10 4-7C10-11 19-10 26-5C18-6 10-4 5 1L3 3 2 10 0 12-2 10-3 3-5 1C-10-4-18-6-26-5Z"/>
    <path class="raven__vane" d="M-26-5C-19-9-11-9-5 1M26-5C19-9 11-9 5 1"/>
  <% elsif raven[:pose] == "hunting" %>
    <ellipse class="raven__cast" cx="4" cy="2" rx="30" ry="4" filter="url(#softShadow)"/>
    <path class="raven__body" d="M-30-8L-22-13C-20-18-14-19-11-16C-8-21-5-26 1-28C9-30 17-26 20-19L34-22L33-16L21-12C15-8 6-7 0-9C-6-11-12-12-17-11L-20-13L-23-10Z"/>
    <path class="raven__wing" d="M0-27C8-28 15-24 18-17L27-19L21-13C14-10 5-12 0-17Z"/>
    <path class="raven__vane" d="M2-25C9-25 14-21 17-16"/>
    <path class="raven__rim"  d="M-11-16C-8-21-5-26 1-28C9-30 17-26 20-19"/>
    <path class="raven__leg"  d="M2-10L2 1M8-10L8 1"/>
    <circle class="raven__eye" cx="-16" cy="-14" r="1"/>
  <% else %>
    <%# Alighting: the far wing behind the body, the near one in front, both
        still up and both showing their primaries. A bird on a branch with its
        wings folded is a shape; a bird arriving is a raven. %>
    <path class="raven__wing" d="M0-31C8-39 16-47 26-52L21-45L29-47L23-40L31-41L24-35L31-35L23-31C15-29 6-28 0-27Z"/>
    <path class="raven__body" d="M-34-29L-26-34.5C-24-39-17-40-13-36C-9-33-4-31 2-29C9-27 14-24 16-20L32-13L29-6L16-12C10-10 2-10-3-13C-9-16-15-22-20-27L-23-28L-26-26Z"/>
    <path class="raven__wing" d="M-14-34C-22-42-30-49-40-53L-35-46L-43-48L-37-41L-45-42L-38-36L-45-36L-37-32C-29-31-21-31-14-30Z"/>
    <path class="raven__vane" d="M-16-33C-24-40-31-46-39-50M-16-31.5C-23-36-30-41-37-44M2-30C9-36 16-42 24-47"/>
    <path class="raven__rim"  d="M-26-34.5C-24-39-17-40-13-36"/>
    <path class="raven__leg"  d="M0-12L1-1M5-12L6-1"/>
    <path class="raven__leg"  d="M-2-1q3.5 4 6.5 0.6M3-1q3.5 4 6.5 0.4"/>
    <circle class="raven__eye" cx="-22" cy="-34" r="1"/>
  <% end %>
</g>
