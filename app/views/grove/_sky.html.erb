<g class="sky">
  <rect x="0" y="0" width="<%= Grove::W.to_i %>" height="<%= Grove::H.to_i %>" fill="url(#skyFace)"/>

  <% grove.stars.each do |star| %>
    <circle class="star" cx="<%= star[:x] %>" cy="<%= star[:y] %>" r="<%= star[:r] %>"
            style="--o: <%= star[:o] %>; opacity: <%= star[:o] %>; animation-delay: <%= star[:delay] %>s"/>
  <% end %>

  <% orb = grove.orb %>
  <%# Sun by day, moon by night, and the desktop's own theme decides which.
      An eclipse outranks both: the internet is down, so the light is gone and
      what is left is the ring around it. %>
  <g class="orb <%= grove.eclipsed? ? "orb--dark" : (grove.night? ? "orb--moon" : "orb--sun") %>">
    <% if grove.eclipsed? %>
      <circle class="orb__bloom" cx="<%= orb[:x] %>" cy="<%= orb[:y] %>" r="<%= orb[:r] * 2.6 %>"
              filter="url(#bloom)" fill="var(--dead)" opacity="0.3"/>
      <circle class="orb__corona" cx="<%= orb[:x] %>" cy="<%= orb[:y] %>" r="<%= orb[:r] + 3 %>"
              stroke-width="3.5" filter="url(#bloom)"/>
      <circle class="orb__corona" cx="<%= orb[:x] %>" cy="<%= orb[:y] %>" r="<%= orb[:r] + 1.5 %>"
              stroke-width="1.6"/>
      <circle class="orb__disc" cx="<%= orb[:x] %>" cy="<%= orb[:y] %>" r="<%= orb[:r] %>"/>
      <circle class="orb__flare" cx="<%= (orb[:x] - orb[:r] * 0.72).round(1) %>"
              cy="<%= (orb[:y] - orb[:r] * 0.7).round(1) %>" r="4.5" filter="url(#bloom)"/>
      <circle class="orb__flare" cx="<%= (orb[:x] - orb[:r] * 0.72).round(1) %>"
              cy="<%= (orb[:y] - orb[:r] * 0.7).round(1) %>" r="2.2"/>
    <% else %>
      <circle class="orb__bloom" cx="<%= orb[:x] %>" cy="<%= orb[:y] %>" r="<%= orb[:r] * 2.2 %>"
              filter="url(#bloom)"/>
      <% unless grove.night? %>
        <% 16.times do |i| %>
          <% a = i * Math::PI / 8 %>
          <line class="orb__ray"
                x1="<%= (orb[:x] + Math.cos(a) * orb[:r] * 1.25).round(1) %>"
                y1="<%= (orb[:y] + Math.sin(a) * orb[:r] * 1.25).round(1) %>"
                x2="<%= (orb[:x] + Math.cos(a) * orb[:r] * (i.even? ? 1.75 : 1.45)).round(1) %>"
                y2="<%= (orb[:y] + Math.sin(a) * orb[:r] * (i.even? ? 1.75 : 1.45)).round(1) %>"/>
        <% end %>
      <% end %>
      <circle class="orb__disc" cx="<%= orb[:x] %>" cy="<%= orb[:y] %>" r="<%= orb[:r] %>"/>
      <% if grove.night? %>
        <circle class="orb__dust" cx="<%= orb[:x] %>" cy="<%= orb[:y] %>" r="<%= orb[:r] %>"
                filter="url(#moonGrain)"/>
        <%# The near side as it is, hard-edged. A moon is legible because it
            has a map on it, and a blurred grey smudge is a stone. %>
        <g transform="translate(<%= orb[:x] %> <%= orb[:y] %>) scale(<%= orb[:r] %>)">
          <g class="orb__seas" filter="url(#seaEdge)">
            <% Grove::MARIA.each do |sea| %>
              <path class="orb__mare" d="<%= sea %>"/>
            <% end %>
          </g>

          <%# Tycho's rays. Faint, long, and all from one point. %>
          <g class="orb__rays">
            <% Grove::RAYS.times do |i| %>
              <% a = i * Math::PI * 2 / Grove::RAYS + 0.4 %>
              <% reach = 0.5 + (i % 3) * 0.22 %>
              <path d="M<%= (-0.1 + Math.cos(a) * 0.05).round(3) %> <%= (0.62 + Math.sin(a) * 0.05).round(3) %>
                       L<%= (-0.1 + Math.cos(a) * reach).round(3) %> <%= (0.62 + Math.sin(a) * reach).round(3) %>"/>
            <% end %>
          </g>
          <circle class="orb__tycho" cx="-0.1" cy="0.62" r="0.035"/>
          <%# A crater is a dish, so it is a shadow with a lit lip round it —
              not a dot with a smaller dot on top, which is a hole in cheese. %>
          <% Grove::CRATERS.each do |cx, cy, cr| %>
            <circle class="orb__crater" cx="<%= cx %>" cy="<%= cy %>" r="<%= cr %>"/>
          <% end %>
        </g>
      <% end %>
    <% end %>
  </g>
</g>
