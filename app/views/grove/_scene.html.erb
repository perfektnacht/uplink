<%# The whole picture, in one element, because that is also the unit that gets
    replaced when a probe changes its mind. Rendering it costs a handful of
    milliseconds and a status change is rare, so there is nothing here to
    update in place and no client-side state to keep in sync.

    Built with no local when it arrives over the stream, since a broadcast has
    nowhere to carry a Grove. %>
<% grove = local_assigns.fetch(:grove) { Grove.draw } %>

<svg id="grove-scene" class="grove<%= " grove--eclipsed" if grove.eclipsed? %>"
     <%# The one place the scene's shape is stated. It was hardcoded here while
         the model was told something else, so the frame drew itself to one
         rectangle and the picture filled another. %>
     viewBox="0 0 <%= Grove::W.to_i %> <%= Grove::H.to_i %>" preserveAspectRatio="xMidYMid meet"
     role="img" aria-label="<%= grove.boughs.size %> limbs, <%= grove.crowns.count { |c| c[:state] != "fallen" } %> crowns and <%= grove.ravens.size %> ravens, grown from your network">
  <%= render "grove/defs" %>
  <%= render "grove/sky", grove: grove %>
  <%= render "grove/land", grove: grove %>

  <%# The wood, in four passes rather than four paths per limb.
      Twigs first and underneath, so the limbs come forward out of the tangle.
      Then all the bodies, then all the shadow, then all the light — because
      drawn limb by limb, every joint is a place where one highlight stops and
      the next starts at a different width, and a trunk built that way comes out
      looking like bamboo. %>
  <g class="tree">
    <g class="wood">
      <%# Every twig is a tapered outline like the limbs, so its width is in its
          geometry rather than in a stroke attribute — which is what lets the
          tree narrow continuously instead of stepping. Two paths carry the
          thousands: the wood you could grip, and the wood you could not. %>
      <%# Wood in the ground is not wood against the sky, but it is still a
          silhouette. The light down here comes up through the soil, so buried
          wood sits below the earth's own value rather than blending into it —
          mixed toward the soil instead, it lands on almost exactly the soil's
          colour and the plate goes missing. And it is not blurred: a root is
          thinner than any blur worth applying, so softening one erases it. %>
      <g class="roots">
        <path class="twig twig--root" d="<%= grove.twigs[:root].join %>"/>
        <path class="twig twig--rootfine" d="<%= grove.twigs[:rootfine].join %>"/>
        <% grove.rootwood.each do |bough| %>
          <path class="bough bough--root<%= " bough--rootdead" if bough[:dead] %>" d="<%= bough[:body] %>"/>
          <circle class="bough bough--root<%= " bough--rootdead" if bough[:dead] %>"
                  cx="<%= bough[:joint][0] %>" cy="<%= bough[:joint][1] %>" r="<%= bough[:joint][2] %>"/>
        <% end %>
      </g>

      <path class="twig twig--limb" d="<%= grove.twigs[:limb].join %>"/>
      <path class="twig twig--fine" d="<%= grove.twigs[:fine].join %>"/>

      <%# No displacement filter on the wood any more. Applied to a group this
          large it was rasterised coarsely and chewed the trunk into blocks —
          and the tree grows enough real detail now that it never needed one. %>
      <g class="wood__body">
        <% grove.boughs.each do |bough| %>
          <path class="bough<%= " bough--dead" if bough[:dead] %>" d="<%= bough[:body] %>"/>
          <circle class="bough<%= " bough--dead" if bough[:dead] %>"
                  cx="<%= bough[:joint][0] %>" cy="<%= bough[:joint][1] %>" r="<%= bough[:joint][2] %>"/>
          <% if bough[:splinter] %><path class="splinter" d="<%= bough[:splinter] %>"/><% end %>
        <% end %>
      </g>
      <path class="grain" d="<%= grove.grain.join %>"/>
      <%# The one edge the moon gets past. %>
      <g class="wood__rim">
        <% grove.boughs.each do |bough| %><path class="bough__rim" d="<%= bough[:rim] %>" opacity="<%= bough[:glare] %>"/><% end %>
      </g>
    </g>

    <%# Leaves are hung on the twigs that exist, so the canopy has the shape the
        wood gave it. Two paths carry the lot. %>
    <g class="canopy">
      <% grove.foliage.group_by { |leaf| leaf[:tone] }.each do |tone, leaves| %>
        <path class="leaves leaves--<%= tone %>" d="<%= leaves.map { |leaf| leaf[:d] }.join %>"/>
      <% end %>
    </g>

  </g>

  <g class="fall">
    <% grove.falling.each do |leaf| %>
      <ellipse class="leaf leaf--falling" cx="<%= leaf[:x] %>" cy="<%= leaf[:y] %>"
               rx="<%= (leaf[:r] * 1.7).round(2) %>" ry="<%= (leaf[:r] * 0.65).round(2) %>"
               transform="rotate(<%= leaf[:tilt] %> <%= leaf[:x] %> <%= leaf[:y] %>)"/>
    <% end %>
    <% grove.litter.each do |leaf| %>
      <ellipse class="leaf" cx="<%= leaf[:x] %>" cy="<%= leaf[:y] %>"
               rx="<%= (leaf[:r] * 1.6).round(2) %>" ry="<%= (leaf[:r] * 0.7).round(2) %>"
               transform="rotate(<%= leaf[:tilt] %> <%= leaf[:x] %> <%= leaf[:y] %>)"/>
    <% end %>

  </g>

  <%# Names live in the topmost layer so a crown drawn later cannot bury one,
      and the pointer finds an invisible disc over the node rather than having
      to land on text that is not there yet. %>
  <g class="names">
    <% grove.labels.each do |label| %>
      <g class="name name--<%= label[:state] %>">
        <%# The offering lives in here with the name it belongs to, so pointing
            at the thing you can see is what reveals it. Kept apart from the
            name's own disc, the only way to find a name was to sweep the
            cursor over a target you could not see — which is the problem this
            was drawn to solve, restated.

            Two groups: the outer one places it, the inner one swings, which is
            what makes `transform-origin: 0 0` the knot the cord is tied at
            rather than the corner of the frame. %>
        <%# A raven is a marker in its own right, so it rides with its name the
            same way an offering does — and for the same reason. Drawn in its
            own layer it was the most conspicuous thing in the picture and the
            one thing pointing at did nothing to. %>
        <% if label[:raven] %><%= render "grove/raven", raven: label[:raven] %><% end %>
        <% if (offering = label[:offering]) %>
          <g transform="translate(<%= offering[:x] %> <%= offering[:y] %>)<%= " rotate(#{offering[:tilt]})" unless offering[:state] == "hung" %>">
            <g class="offering offering--<%= offering[:state] %>"
               style="--dur: <%= offering[:dur] %>s; --delay: <%= offering[:delay] %>s">
              <% if offering[:beads] %>
                <line class="offering__cord" x1="0" y1="0" x2="0" y2="<%= offering[:top] %>"/>
                <% offering[:beads].each do |by| %><circle class="offering__bead" cx="0" cy="<%= by %>" r="<%= (offering[:r] * 0.16).round(2) %>"/><% end %>
              <% end %>
              <%= render "grove/offering", offering: offering %>
            </g>
          </g>
        <% end %>
        <circle class="name__ring" cx="<%= label[:x] %>" cy="<%= label[:y] %>" r="<%= label[:ring] %>"/>
        <%# Relief, lit from the same corner as everything else: the shadow copy
            sits below and right of the face, so the letters stand proud of the
            dark rather than being printed on it. %>
        <text class="name__bevel" x="<%= label[:tx] + 0.9 %>" y="<%= label[:ty] + 1.2 %>" text-anchor="<%= label[:anchor] %>"><%= label[:text] %></text>
        <text class="name__halo"  x="<%= label[:tx] %>" y="<%= label[:ty] %>" text-anchor="<%= label[:anchor] %>" filter="url(#rim)"><%= label[:text] %></text>
        <text class="name__text"  x="<%= label[:tx] %>" y="<%= label[:ty] %>"     text-anchor="<%= label[:anchor] %>"><%= label[:text] %></text>
        <circle class="name__hit" cx="<%= label[:x] %>" cy="<%= label[:y] %>" r="<%= label[:hit] %>"/>
      </g>
    <% end %>
  </g>

  <%= render "grove/frame" %>
</svg>
