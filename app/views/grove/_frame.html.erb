<%# The picture is hung in something. Four rails of wood with a plait carved
    down each of them and a knot cut into every corner block — which is where
    the Nordic character of this thing lives now that the stone is gone. %>
<% b = Grove::BORDER %>
<% corner = 104 %>
<g class="frame">
  <%# One outline for the whole frame, corner blocks included. Drawn as rails
      with squares laid on top, the squares' inner edges cut visibly across the
      rails — joinery does not have a seam down the middle of a corner. %>
  <% k = corner %>
  <% out = 700 %>
  <%# The wood runs well past the edge of the picture, and the svg is allowed to
      paint outside its own box, so the rails reach the edge of the window
      whatever shape the window is. Otherwise the frame floats in a letterbox
      with the scene showing through beside it. %>
  <path class="frame__wood" fill-rule="evenodd"
        d="M<%= -out %> <%= -out %>H<%= Grove::W + out %>V<%= Grove::H + out %>H<%= -out %>Z
           M<%= b %> <%= k %>H<%= k %>V<%= b %>H<%= Grove::W - k %>V<%= k %>H<%= Grove::W - b %>
           V<%= Grove::H - k %>H<%= Grove::W - k %>V<%= Grove::H - b %>H<%= k %>V<%= Grove::H - k %>H<%= b %>Z"/>

  <% [ [ 0, 0, 1, 1 ], [ Grove::W, 0, -1, 1 ], [ 0, Grove::H, 1, -1 ], [ Grove::W, Grove::H, -1, -1 ] ].each_with_index do |(cx, cy, fx, fy), i| %>
    <g transform="translate(<%= cx %> <%= cy %>) scale(<%= fx %> <%= fy %>)">
      <g class="sigil" transform="translate(52 52) scale(<%= 1.7 * fx %> <%= 1.7 * fy %>)">
        <path d="<%= Grove::SIGILS[i] %>"/>
      </g>
    </g>
  <% end %>

  <% [ [ "translate(#{corner} #{b / 2})", Grove::W - corner * 2 ],
       [ "translate(#{corner} #{Grove::H - b / 2})", Grove::W - corner * 2 ],
       [ "translate(#{b / 2} #{corner}) rotate(90)", Grove::H - corner * 2 ],
       [ "translate(#{Grove::W - b / 2} #{corner}) rotate(90)", Grove::H - corner * 2 ] ].each do |place, run| %>
    <% weave = Grove.plait(run, 11, 74) %>
    <g transform="<%= place %>">
      <path class="frame__knot" d="<%= weave[:over] %>"/>
      <path class="frame__knot" d="<%= weave[:under] %>"/>
      <% weave[:overs].each do |patch| %>
        <path class="frame__gap"  d="<%= patch %>"/>
        <path class="frame__knot" d="<%= patch %>"/>
      <% end %>
    </g>
  <% end %>

  <%# Cut into the ground either side of the root plate, in columns that hang
      from one line and run down to different depths. A single even row across
      the middle ran through the roots and read as a caption; this reads as
      writing standing beside the picture, which is what it is. %>
  <g class="sigil">
    <% [ 128, 1206 ].each_with_index do |left, side| %>
      <% Grove.script(4_100 + side, 6).each do |column, marks| %>
        <% marks.each_with_index do |mark, row| %>
          <path transform="translate(<%= left + column * 44 %> <%= Grove::SCRIPT_TOP + row * Grove::SCRIPT_STEP %>) scale(0.52)"
                d="<%= mark %>"/>
        <% end %>
      <% end %>
    <% end %>
  </g>
</g>
