<div class="form">
  <header class="form__head">
    <h3>Cable</h3>
    <a class="form__close" href="#" data-action="inspector#close">×</a>
  </header>

  <%= form_with model: link, html: { autocomplete: "off" } do |form| %>
  <% if link.errors.any? %>
    <ul class="form__errors">
      <% link.errors.full_messages.each do |message| %><li><%= message %></li><% end %>
    </ul>
  <% end %>

  <%# Which two things this joins, and which way round. Direction does not
      change how the cable is drawn — the route is computed from where the
      cards actually are — but it decides which end you are renaming here. %>
  <fieldset class="form__row">
    <label><span>From</span><%= form.collection_select :from_node_id, Node.ordered, :id, :name %></label>
    <label><span>To</span><%= form.collection_select :to_node_id, Node.ordered, :id, :name %></label>
  </fieldset>

  <label>
    <span>Kind</span>
    <%= form.select :kind, Link::KINDS %>
  </label>
  <label><span>Label</span><%= form.text_field :label, **unmanaged({placeholder: "DNS"}) %></label>
  <p class="form__hint">
    <strong>logical</strong> is for a link that is real but not physical. It is
    drawn as a chip on the card that uses the service rather than as a cable,
    so every machine can point at one Pi-hole without turning the diagram into
    string. The label is what the chip says — <em>DNS</em>, <em>VPN</em>,
    <em>NTP</em>. Leave it blank to name the far end instead.
  </p>

    <footer class="form__foot">
      <%= form.submit "Save", class: "btn btn--go" %>
    </footer>
  <% end %>

  <footer class="form__foot form__foot--split">
    <%= button_to "Delete cable", link, method: :delete, class: "btn btn--danger" %>
  </footer>
</div>
