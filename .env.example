# Copy to .env. Compose reads .env from this directory whoever runs the
# command, which is the whole point of it: docker on Omarchy goes through
# sudo, and sudo may rewrite HOME to /root, so the desktop Uplink mounts is
# named here rather than inherited from the environment.
#
#   cp .env.example .env && sed -i "s|__HOME__|$HOME|" .env
#
UPLINK_HOME=__HOME__
